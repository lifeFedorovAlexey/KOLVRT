{
  "coverage": [
    {
      "evidence": "kernel_core::elf::parse malformed image inputs",
      "level": "UNIT",
      "name": "elf"
    },
    {
      "evidence": "actual denied child lifecycle/SEND/reply and root binding calls",
      "level": "SYSTEM",
      "name": "authorization"
    },
    {
      "evidence": "old lifecycle token and SEND handle return exact stale errors",
      "level": "SYSTEM",
      "name": "stale-instance"
    },
    {
      "evidence": "wrong target token denied; correct binding reaches actual service",
      "level": "SYSTEM",
      "name": "readiness-binding"
    },
    {
      "evidence": "production reply parser malformed inputs; forged public reply rejected",
      "level": "UNIT/SYSTEM",
      "name": "reply"
    },
    {
      "evidence": "wrong endpoint kind rejected; actual submit/wait/collect/RPC round trips",
      "level": "SYSTEM",
      "name": "ipc"
    },
    {
      "evidence": "live replacement denied, actual kernel zero charges/frames restored, host oracle rejects retained-resource observations",
      "level": "SYSTEM/UNIT",
      "name": "resource-release"
    }
  ],
  "hardware": "UNKNOWN",
  "limitations": [
    "Not source-mutant detection",
    "Not production supervisor crash-recovery acceptance",
    "Fixture mutations are UNIT inputs, not kernel execution"
  ],
  "scope": "invalid inputs to actual production methods/public ABI and host oracle; no source mutation or corrupted application implementation",
