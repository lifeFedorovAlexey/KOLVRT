{
  "schema_version": 1,
  "architecture": "ARM64",
  "platform_kind": "QEMU",
  "qemu_version": "10.1.0",
  "qemu_arguments_without_kernel": [
    "-machine",
    "virt-10.1,gic-version=3,virtualization=on,its=off,dtb-randomness=off",
    "-cpu",
    "cortex-a57",
    "-accel",
    "tcg",
    "-smp",
    "2",
    "-m",
    "256M",
    "-display",
    "none",
    "-serial",
    "stdio",
    "-monitor",
    "none",
    "-nic",
    "none",
    "-no-reboot"
  ],
  "configured_cpus": 2,
  "active_cpus": 2,
  "execution_profile": "DEV",
  "compiler": "rustc",
  "compiler_version": "1.99.0",
  "target": "aarch64-unknown-none",
  "rustflags": ["-C", "force-frame-pointers=yes", "-D", "warnings"],
  "cargo_profile": "dev",
  "kernel_features": ["machine-events", "diagnostics", "native-apps"],
  "actor_features": ["guest"],
  "expected_counter_frequency": 62500000,
  "frequency_policy": "Every CLOCK sample must match the declared frequency; mismatch rejects, not rescales the class.",
  "image_policy": "Pair-specific kernel and actor hashes belong to retained run provenance, not this shared class configuration."
}
