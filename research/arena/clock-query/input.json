{
  "schema_version": 1,
  "workload": "arena.workload.clock-query",
  "version": "1",
  "opaque_argument_variable": "KOLVRT_NATIVE_ARGUMENT",
  "off_argument": 1,
  "on_argument": 2,
  "warmup_samples": 4,
  "measured_samples": 24,
  "useful_queries_per_iteration": 1,
