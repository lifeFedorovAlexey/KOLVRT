{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOLVRT COST-L allocation ledger v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "allocated_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^COST-L-[0-9]{4}$"
      }
    }
  },
  "required": ["schema_version", "allocated_ids"]
}
