                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "pattern": "\\S"
                      }
                    },
                    "required": ["id", "version"],
                    "additionalProperties": false
                  }
                ]
              },
              "expected_replacement": {
