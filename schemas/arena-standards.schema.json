{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOLVRT Arena standards registry v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true
          },
          "source_kind": {
            "enum": [
              "INTERNATIONAL_STANDARD",
              "GOVERNMENT_GUIDANCE",
              "CONSORTIUM_RULES",
              "DE_FACTO",
              "KOLVRT_DEFINED"
            ]
          },
          "role": {
            "enum": ["MANDATORY", "REFERENCE"]
          },
          "authoritative_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "last_checked": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          },
          "publication_state": {
            "enum": ["PUBLISHED", "DRAFT"]
          },
          "superseded_by": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$",
                    "maxLength": 160
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S"
                  }
                },
                "required": ["id", "version"],
                "additionalProperties": false
              }
            ]
          },
          "expected_replacement": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            ]
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "scope",
          "source_kind",
          "role",
          "authoritative_source",
          "source_revision",
          "last_checked",
          "publication_state",
          "superseded_by",
          "expected_replacement"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "required": ["schema_version", "registry_version", "entries"],
  "additionalProperties": false
}
